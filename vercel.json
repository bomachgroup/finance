{
  "rewrites": [
    {
      "source": "/api/live/api/:path*",
      "destination": "https://bomachauth.bgbot.app/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://bomachauthtest.bgbot.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
